rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Product Images
    match /products/{productId}/{imageId} {
      // Anyone can download product images
      allow read: if true;

      // Only staff can upload or delete product images
      allow write: if isAuthenticated() && isImageFile();
      allow delete: if isAuthenticated();
    }

    // Catalog Scans & OCR Pages
    match /catalog_scans/{scanId}/{pageId} {
      allow read, write: if isAuthenticated() && isImageFile();
      allow delete: if isAuthenticated();
    }

    // Backups
    match /backups/{backupFile} {
      allow read, write: if isAuthenticated();
    }
  }
}
